#!/usr/bin/env bash
# Configures local host resolution in /etc/hosts

# Update existing localhost entry from 127.0.0.1 to 127.0.0.2
sed -i 's/127\.0\.0\.1/127\.0\.0\.2/g' /etc/hosts

# Add or update facebook.com resolution to 8.8.8.8
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/.*facebook\.com.*/8.8.8.8 facebook.com/' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
